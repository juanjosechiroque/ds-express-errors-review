{
    "name": "ds-express-errors-review",
    "version": "1.0.0",
    "description": "Small Express + TypeScript app used to independently test ds-express-errors (Mongoose, Zod, JWT integration)",
    "main": "dist/index.js",
    "type": "module",
    "scripts": {
        "start": "NODE_ENV=production node dist/index.js",
        "dev": "NODE_ENV=development nodemon index.ts",
        "build": "tsc",
        "validate": "eslint . && prettier --check .",
        "format": "prettier --write . && eslint . --fix",
        "seed": "tsx src/scripts/seed.ts",
        "smoke": "bash scripts/smoke-test.sh",
        "test": "vitest run",
        "test:coverage": "vitest run --coverage",
        "typecheck": "tsc --project tsconfig.check.json"
    },
    "keywords": [
        "express",
        "nodejs",
        "typescript",
        "mongodb",
        "jwt",
        "mongoose",
        "zod",
        "ds-express-errors"
    ],
    "author": "juanjosechiroque",
    "license": "MIT",
    "engines": {
        "node": ">=24"
    },
    "dependencies": {
        "bcrypt": "^6.0.0",
        "express": "^5.0.1",
        "jsonwebtoken": "^9.0.2",
        "mongoose": "^8.9.4",
        "pino": "^10.3.1",
        "pino-http": "^11.0.0",
        "zod": "^4.4.3"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@types/bcrypt": "^6.0.0",
        "@types/express": "^5.0.6",
        "@types/jsonwebtoken": "^9.0.10",
        "@types/node": "^26.1.0",
        "@types/supertest": "^7.2.0",
        "@vitest/coverage-v8": "^4.1.9",
        "dotenv": "^16.4.7",
        "eslint": "^10.2.0",
        "eslint-config-prettier": "^10.1.8",
        "globals": "^17.4.0",
        "nodemon": "^3.1.9",
        "pino-pretty": "^13.1.3",
        "prettier": "^3.8.1",
        "supertest": "^7.0.0",
        "tsx": "^4.23.0",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.62.1",
        "vitest": "^4.1.9"
    },
    "allowScripts": {
        "bcrypt@6.0.0": true,
        "esbuild@0.28.1": true,
        "fsevents@2.3.3": true,
        "unrs-resolver@1.11.1": true
    }
}
